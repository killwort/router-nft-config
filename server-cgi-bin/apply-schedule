#!/bin/bash
set -euo pipefail

. /usr/lib/cgi-bin/make-nft-sets

CONFIG="/usr/lib/cgi-bin/config.json"

NFT_FAMILY="ip"
NFT_TABLE="filter"
NFT_PARENT_CHAIN="forward"
NFT_CHAIN="scheduled_l2"
EXCLUSIONS_CHAIN="schedule_exclusions"
CURRENT_HOUR=$(date +%-H)

#
# �а�ал�на� на���ойка.
# Созда�м chain и пе�е�од в него, е�ли они е�� не ���е��в���.
# Э�о в�полн�е��� о�дел�н�ми командами, по�кол�к� об��но по��еб�е���
# �ол�ко п�и пе�вом зап��ке.
#

nft add chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_CHAIN" 2>/dev/null || true
nft add set "$NFT_FAMILY" "$NFT_TABLE" "$EXCLUSIONS_CHAIN" '{ type ether_addr; }' 2>/dev/null || true

if ! nft list chain "$NFT_FAMILY" "$NFT_TABLE" "$NFT_PARENT_CHAIN" \
    | grep -q 'comment "scheduled-l2"'
then
    nft add rule \
        "$NFT_FAMILY" "$NFT_TABLE" "$NFT_PARENT_CHAIN" \
        jump "$NFT_CHAIN" \
        comment '"scheduled-l2"'
fi


#
# Фо�ми��ем ��анзак�и� nft:
#
#   flush chain ...
#   add rule ...
#   add rule ...
#
# и пе�еда�м е� nft одним в�зовом.
#

{
    echo "flush chain $NFT_FAMILY $NFT_TABLE $NFT_CHAIN"
    echo "add rule $NFT_FAMILY $NFT_TABLE $NFT_CHAIN ether saddr @$EXCLUSIONS_CHAIN return"

    jq -r --argjson hour "$CURRENT_HOUR" '
        .rules
        | to_entries[]
        | .key as $group
        | .value as $rules

        # �а�одим по�леднее �же на���пив�ее �об��ие.
        |
        (
            [
                $rules[]
                | select((.at | tonumber) <= $hour)
            ]
            | sort_by(.at | tonumber)
            | last
        )
        //
        (
            # ��ли �егодн� �об��ий е�� не б�ло,
            # бе��м по�леднее �об��ие п�ед�д��и� ���ок.
            $rules
            | sort_by(.at | tonumber)
            | last
        )

        | .actions[]
        | [$group, .]
        | @tsv
    ' "$CONFIG" |
    while IFS=$'\t' read -r group action; do
        case "$action" in
            allow-l2)
                # �икакого п�авила не ��еб�е���.
                ;;

            block-l2)
                echo "add rule $NFT_FAMILY $NFT_TABLE $NFT_CHAIN ether saddr @fgroup_$group drop"
                ;;

            *)
                echo "Unknown action '$action' for group '$group'" >&2
                exit 1
                ;;
        esac
    done

} | nft -f -
