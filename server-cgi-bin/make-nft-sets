#!/bin/bash
set -euo pipefail

JSON_FILE="/usr/lib/cgi-bin/config.json"
TABLE_FAMILY="ip"
TABLE_NAME="filter"
PREFIX="fgroup_"

# Сна�ала о�и�аем в�е �анее �озданн�е нами set'�.
sudo nft -j list table "$TABLE_FAMILY" "$TABLE_NAME" |
jq -r --arg prefix "$PREFIX" '
  .nftables[]
  | .set?
  | select(. != null)
  | .name
  | select(startswith($prefix))
' |
while read -r setname; do
    sudo nft flush set "$TABLE_FAMILY" "$TABLE_NAME" "$setname"
done

# �а�ем заполн�ем ак��ал�н�ми данн�ми.
jq -r '
  .knownDevices
  | to_entries
  | map(
      .key as $mac
      | (.value.groups // [])[]
      | {
          group: .,
          mac: $mac
        }
    )
  | group_by(.group)
  | .[]
  | [
      .[0].group,
      (map(.mac) | join(", "))
    ]
  | @tsv
' "$JSON_FILE" |
while IFS=$'\t' read -r group macs; do
    setname="${PREFIX}${group}"

    sudo nft add set "$TABLE_FAMILY" "$TABLE_NAME" "$setname" \
        '{ type ether_addr; }' 2>/dev/null || true

    sudo nft add element "$TABLE_FAMILY" "$TABLE_NAME" "$setname" \
        "{ $macs }"
done
